{
  "name": "simpright",
  "version": "0.2.0",
  "description": "The SimpRight Kit's command-line tool: `simpright doctor` checks a project's setup. Also simpright.yml's schema and reader for the kit's other packages.",
  "keywords": [
    "simpright",
    "playwright",
    "test-automation",
    "qa"
  ],
  "license": "MIT",
  "author": "Andrii Zaitsev",
  "homepage": "https://github.com/Zaytsman/SimpRightKit/tree/main/packages/simpright#readme",
  "bugs": "https://github.com/Zaytsman/SimpRightKit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaytsman/SimpRightKit.git",
    "directory": "packages/simpright"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "simpright": "dist/cli.js"
  },
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "default": "./dist/workflows.js"
    },
    "./simpright.schema.json": "./simpright.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "simpright.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
