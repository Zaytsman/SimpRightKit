{
  "name": "@simpright/portal",
  "version": "0.1.0",
  "description": "A static dashboard for Playwright runs: run history, trends and known issues, plus Test Cases and Bugs pages, published into any folder (GitHub Pages, or anywhere else).",
  "keywords": [
    "simpright",
    "playwright",
    "dashboard",
    "test-report",
    "github-pages"
  ],
  "license": "MIT",
  "author": "Andrii Zaitsev",
  "homepage": "https://github.com/Zaytsman/SimpRightKit/tree/main/packages/portal#readme",
  "bugs": "https://github.com/Zaytsman/SimpRightKit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zaytsman/SimpRightKit.git",
    "directory": "packages/portal"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "simpright-portal": "dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "pages",
    "sample"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "simpright": "0.1.0",
    "yaml": "^2.9.1"
  }
}
