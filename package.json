{
  "name": "simpright-kit",
  "private": true,
  "description": "SimpRight Kit: the installable parts of the SimpRight test framework (the simpright tool, scenarios, portal)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/simpright",
    "packages/scenarios",
    "packages/portal"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run build && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"packages/*/test/**/*.test.ts\"",
    "check:packages": "node scripts/check-packages.ts",
    "sample:build": "npm run build && node scripts/sample-site.ts",
    "test:screenshots": "npm run sample:build && playwright test -c packages/portal/screenshots",
    "release": "node scripts/release.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "chart.js": "4.5.1",
    "typescript": "^7.0.2"
  }
}
